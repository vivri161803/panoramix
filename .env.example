# Copia questo file in .env.local e inserisci i valori veri (mai nel repository).

# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# chiave pubblica: "publishable" (sb_publishable_…) oppure "anon" legacy
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chiave segreta: "secret" (sb_secret_…) oppure "service_role" legacy — solo lato server, solo nel cron
SUPABASE_SERVICE_ROLE_KEY=

# Email via Gmail con password per le app
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tua.casella@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=Panoramix

# Solo se EMAIL_PROVIDER=resend (serve un dominio verificato su Resend)
RESEND_API_KEY=
# Indirizzo mittente per Resend (facoltativo con SMTP: di default è SMTP_USER)
MAIL_FROM_ADDRESS=

# Segreto del controllo giornaliero: stringa casuale lunga (es. `openssl rand -hex 32`)
CRON_SECRET=

# Indirizzo pubblico dell'app, senza barra finale (in locale http://localhost:3000)
APP_URL=http://localhost:3000
